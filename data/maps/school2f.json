    { "x": 7.4, "y": 9.35, "text": "재민이도 온대", "angle": -4, "cond": { "flag": "stage2" } },
    { "x": 29.3, "y": 10.4, "text": "뜨거워", "angle": 6, "cond": { "flag": "stage2" } }
  ],
  "decor": [
