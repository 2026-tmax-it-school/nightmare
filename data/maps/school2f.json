    { "x": 17, "y": 9, "tex": "scorch", "cond": { "flag": "stage2" } },
    { "x": 18, "y": 10, "tex": "scorch", "cond": { "flag": "stage2" } },
    { "x": 26, "y": 8, "tex": "scorch", "cond": { "flag": "stage2" } },
    { "x": 30, "y": 13, "tex": "scorch", "cond": { "flag": "stage2" } }
  ],
  "onEnter": {
    "once": "ch2_start",
    "script": [
      { "t": "chapter", "title": "2장", "sub": "2층" },
      { "t": "save" },
      { "t": "text", "text": "2층. 공기가 한층 더 차갑다." },
      { "t": "text", "text": "……어디선가 피아노 건반 하나가 울린 것 같다." },
      { "t": "text", "who": "재민", "text": "……음악실인가." }
    ]
  },
