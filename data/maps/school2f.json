    { "x": 18, "y": 2, "tex": "pc", "script": "pc_off" },
    { "x": 20, "y": 2, "tex": "pc", "script": "pc_off" },
    { "x": 14, "y": 4, "tex": "pc", "script": "pc_off" },
    { "x": 16, "y": 4, "tex": "pc", "script": "pc_off" },
