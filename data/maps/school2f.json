    { "x": 5, "y": 1, "tex": "board", "script": "board_music" },
    { "x": 6, "y": 1, "tex": "board", "script": "board_music" },
    { "x": 9, "y": 1, "tex": "piano_l", "script": "piano" },
    { "x": 10, "y": 1, "tex": "piano_r", "script": "piano" },
    { "x": 9, "y": 2, "tex": "bench", "script": "bench" },
    { "x": 0, "y": 3, "script": "window_music" },
    { "x": 3, "y": 4, "tex": "stand", "script": "stand" },
    { "x": 5, "y": 4, "tex": "stand", "script": "stand" },
    { "x": 7, "y": 4, "tex": "stand", "script": "stand" },
    { "x": 11, "y": 6, "tex": "locker", "hide": true, "view": "music" },

    { "x": 14, "y": 2, "tex": "pc", "script": "pc_off" },
