  "scripts": {
    "near13": [
      { "t": "text", "text": "복도 양쪽으로 교실들이 늘어서 있다. 그중 한 교실 앞에서 발걸음이 멈춘다." },
      { "t": "text", "text": "교실 문은 반쯤 열려 있다." },
      { "t": "text", "who": "재민", "text": "여긴…" },
      { "t": "text", "text": "이상하게도, 다른 교실보다 익숙한 느낌이 든다." }
    ],
    "enter13": [
      { "t": "text", "text": "오래된 책상과 의자. 칠판에는 지워진 글씨의 흔적이 남아 있다." },
      { "t": "text", "text": "한쪽 벽에는 학급 게시판이, 교탁 위에는 무언가가 놓여 있다." }
    ],
    "lectern": [
      {
        "t": "if", "cond": { "notFlag": "read_attendance" },
        "then": [
          { "t": "text", "text": "교탁 위에 낡은 출석부가 놓여 있다." },
          { "t": "text", "text": "펼쳐 보니 한 학생의 이름만 빨간 줄로 지워져 있다." },
          { "t": "text", "text": "12번 ── (빨간 줄로 지워져 읽을 수 없다)\n13번 ── 윤재민" },
          { "t": "text", "who": "재민", "text": "내 이름이… 왜 여기 있어?" },
          { "t": "text", "text": "마지막 장을 넘긴다. 7월 14일 이후로는 출석 기록이 없다." },
          { "t": "text", "text": "그날, 12번 칸에만 아무 표시도 없다." },
          { "t": "flag", "key": "read_attendance" },
          { "t": "clue", "id": "attendance" },
          { "t": "clue", "id": "date714" }
        ],
        "else": [{ "t": "text", "text": "출석부. 12번은 빨간 줄로 지워져 있고, 13번이 내 이름이다. 마지막 출석일은 7월 14일." }]
      }
    ],
    "notice": [
      {
        "t": "if", "cond": { "notFlag": "read_seatchart" },
        "then": [
          { "t": "text", "text": "빛바랜 학급 사진 몇 장이 붙어 있다. 너무 오래되어 얼굴을 알아보기 어렵다." },
          { "t": "text", "who": "재민", "text": "……왜 이렇게 익숙하지?" },
          { "t": "text", "who": "재민", "text": "여기… 내가 있었던 곳인가?" },
          { "t": "text", "text": "기억을 떠올리려 하지만, 아무것도 생각나지 않는다." },
          { "t": "text", "text": "사진 옆에 찢어진 자리 배치도가 붙어 있다. 이름은 대부분 바래 있다." },
          { "t": "text", "text": "구석에 연필 메모 ── 「번호순. 창가 분단 맨 앞자리부터 뒤로.」" },
          { "t": "flag", "key": "read_seatchart" },
          { "t": "clue", "id": "photo" },
          { "t": "clue", "id": "seatchart" }
        ]
      },
      {
        "t": "if", "cond": { "flag": "p1" },
        "then": [{ "t": "text", "text": "자리 배치도. 창가에서 세 번째 분단, 맨 뒷자리가 12번이었다." }],
        "else": [
          {
            "t": "if", "cond": { "notFlag": "read_attendance" },
            "then": [{ "t": "text", "who": "재민", "text": "누가 몇 번이었는지 알 수 있는 게 있으면 좋을 텐데…" }],
            "else": [
              {
                "t": "choice", "prompt": "배치도에서 지워진 12번의 자리를 찾아볼까?",
                "options": [
                  {
                    "label": "찾아본다",
                    "then": [
                      {
                        "t": "puzzle", "id": "seat1",
                        "success": [
                          { "t": "flag", "key": "p1" },
                          { "t": "text", "text": "창가에서 세 번째 분단, 맨 뒷자리." },
                          { "t": "text", "who": "재민", "text": "……저 자리다." },
                          { "t": "sfx", "name": "deskDrag" },
                          { "t": "wait", "ms": 260 },
                          { "t": "sfx", "name": "deskDrag" },
                          { "t": "wait", "ms": 260 },
                          { "t": "sfx", "name": "deskDrag" },
                          { "t": "syncObjects" },
                          { "t": "text", "text": "끼익── 끼이익. 교실 뒤쪽에서 책상을 끄는 소리가 났다." },
                          { "t": "text", "text": "돌아보니 12번 자리 둘레가 책상과 의자로 빙 둘러 막혀 있다." },
                          { "t": "text", "who": "재민", "text": "……일부러 이렇게 둔 거야. 그 아이 자리만." },
                          { "t": "text", "who": "재민", "text": "의자를 무너뜨리지 않게 조심해야 해. ……이 학교엔, 나 말고 뭔가가 있어." },
                          { "t": "save" }
                        ]
                      }
                    ]
                  },
                  { "label": "그만둔다", "then": [] }
                ]
              }
            ]
          }
        ]
      }
    ],
    "board11": [{ "t": "text", "text": "칠판 구석에 「졸업 축하해!」 …폐교 전 마지막 졸업식이었을까." }],
    "_guilt": "기억의 변질 (GDD 4.4-2): 죄책감 단계(guiltAtLeast)에 따라 같은 물건의 묘사가 바뀐다",
    "board12": [
      {
        "t": "if", "cond": { "guiltAtLeast": 3 },
        "then": [{ "t": "text", "text": "칠판은 깨끗하게 지워져 있다. ……그 별명을 칠판에 처음 크게 쓴 손이, 내 손이었다." }],
        "else": [{ "t": "text", "text": "칠판은 깨끗하게 지워져 있다. 너무 깨끗하다." }]
      }
    ],
    "board13": [
      {
        "t": "if", "cond": { "flag": "frag1" },
        "then": [
          { "t": "sfx", "name": "glitch" },
          { "t": "text", "text": "칠판에 하얀 글씨가 떠올라 있다." },
          { "t": "text", "text": "「기억해.」" }
        ],
        "else": [{ "t": "text", "text": "지워진 글씨의 흔적이 남아 있다. 알아볼 수는 없다." }]
      }
    ],
    "desk": [
      {
        "t": "if", "cond": { "guiltAtLeast": 3 },
        "then": [{ "t": "text", "text": "낡은 책상. ……어느 책상을 봐도, 그 애 책상에 칼로 긋던 소리가 들린다." }],
        "else": [
          {
            "t": "if", "cond": { "guiltAtLeast": 2 },
            "then": [{ "t": "text", "text": "낡은 책상. 상판에 칼로 긁은 자국이 길게 남아 있다." }],
            "else": [{ "t": "text", "text": "낡은 책상. 서랍은 비어 있다." }]
          }
        ]
      }
    ],
    "desk_pushed": [{ "t": "text", "text": "누군가 끌어다 놓은 책상. 바닥에 끈 자국이 남아 있다. ……밀면 움직일 것 같다." }],
    "desk13_moved": [
      { "t": "text", "text": "창가 구석까지 끌려온 책상. 귀퉁이에 「윤재민」이라고 새겨져 있다." },
      { "t": "text", "who": "재민", "text": "……내 책상이다. 내 자리엔 의자만 잔뜩 쌓여 있고." },
      { "t": "text", "who": "재민", "text": "그 아이를 가둔 벽이, 내 자리에서부터 쌓여 있어." },
      { "t": "text", "text": "바닥에 끈 자국이 남아 있다. ……밀면 움직일 것 같다." }
    ],
    "seat13_pile": [
      { "t": "text", "text": "13번 ── 내 자리였던 곳에 의자가 거꾸로 위태롭게 쌓여 있다." },
      { "t": "text", "text": "조금만 부딪쳐도 와르르 무너질 것 같다." }
    ],
    "desk_pile": [{ "t": "text", "text": "책상 위에 의자가 거꾸로 위태롭게 쌓여 있다. 조금만 부딪쳐도 와르르 무너질 것 같다." }],
    "pile_fall": [
      { "t": "sfx", "name": "chairsFall" },
      { "t": "effect", "name": "shake", "ms": 500, "i": 0.02 },
      { "t": "text", "text": "와르르── 쌓여 있던 의자들이 한꺼번에 무너졌다." },
      { "t": "text", "text": "소리가 복도 끝까지 울려 퍼진다. ……그리고, 뚝 멎는다." },
      { "t": "sfx", "name": "follow", "wait": true },
      { "t": "text", "who": "재민", "text": "……뭔가, 온다." },
      { "t": "shadowStrike", "from": { "x": 25, "y": 9 } }
    ],
    "desk_piano": [{ "t": "text", "text": "책상 위에 볼펜으로 그린 피아노 건반이 남아 있다. 손가락으로 연습이라도 한 것처럼 닳아 있다." }],
    "desk13": [
      { "t": "text", "text": "책상 귀퉁이에 「윤재민」이라고 새겨져 있다." },
      { "t": "text", "who": "재민", "text": "……내 글씨다." },
      {
        "t": "if", "cond": { "guiltAtLeast": 3 },
        "then": [
          { "t": "text", "text": "같은 칼자국으로, 옆자리 쪽을 향해 그어 놓은 줄이 몇 개 더 있다." },
          { "t": "text", "who": "재민", "text": "……이것도, 내가 그었어." }
        ]
      }
    ],
    "desk12": [
      {
        "t": "if", "cond": { "flag": "frag1" },
        "then": [{ "t": "text", "text": "12번의 책상. 서랍은 이제 비어 있다." }],
        "else": [
          {
            "t": "if", "cond": { "notFlag": "p1" },
            "then": [{ "t": "text", "text": "낡은 책상이다. 서랍이 뻑뻑해서 열리지 않는다." }],
            "else": [
              { "t": "text", "text": "힘을 주어 서랍을 당기자, 깊숙이 끼어 있던 공책 한 권이 빠져나온다." },
              { "t": "clue", "id": "notebook" },
              { "t": "text", "text": "공책은 낙서로 가득하다. 「피아노 왕자 ㅋㅋ」 「냄새나」 「꺼져」" },
              { "t": "text", "text": "그 사이에, 작고 반듯한 글씨가 있다." },
              { "t": "text", "text": "「재민이는 중학교 때 내 유일한 친구였는데.」" },
              { "t": "memory", "lines": ["(낄낄거리는 웃음소리)", "“야, 피아노 왕자. 한 곡 쳐 봐.”", "(누군가 흐느끼는 소리)", "“재민아, 너도 웃기지?”", "“……응.”"] },
              { "t": "text", "who": "재민", "text": "……방금 뭐였지?" },
              { "t": "flag", "key": "frag1" },
              { "t": "fragment", "n": 1 },
              { "t": "deduction", "id": "d1" },
              { "t": "text", "who": "재민", "text": "7월 14일… 그날 무슨 일이 있었던 거지." },
              { "t": "text", "who": "재민", "text": "학교 기록이 남아 있을 만한 곳… 입구 쪽에 경비실이 있었다." }
            ]
          }
        ]
      }
    ],
    "door_staff": [
      {
        "t": "if", "cond": { "item": "keyOffice" },
        "then": [
          { "t": "openDoor", "id": "staff" },
          { "t": "text", "text": "교무실 열쇠를 꽂자, 자물쇠가 힘없이 돌아간다." },
          { "t": "text", "who": "재민", "text": "……담임이 숨기려던 게, 여기 있어." },
          { "t": "chapter", "title": "4장", "sub": "교무실" },
          { "t": "save" }
        ],
        "else": [{ "t": "text", "text": "교무실. 잠겨 있다. 유리창 너머로 서류 더미가 보인다." }]
      }
    ],
    "office_desk": [{ "t": "text", "text": "다른 선생님들의 책상. 서랍은 전부 비어 있다. 마치 누가 서둘러 치운 것처럼." }],
    "office_cabinet": [
      {
        "t": "if", "cond": { "notFlag": "read_report" },
        "then": [
          { "t": "text", "text": "서류함 맨 아래 칸에 「학생 사고 처리 — 대외비」라고 적힌 파일이 꽂혀 있다." },
          { "t": "text", "text": "「7월 14일 방과후 과학실 화재. 1학년 3반 한도윤 사망.」" },
          { "t": "text", "text": "「원인 — 학생 개인의 실험 부주의.」" },
          { "t": "text", "text": "그 아래 몇 줄은 검은 매직으로 두껍게 먹칠되어 있다." },
          { "t": "text", "who": "재민", "text": "……단순 사고라고? 지워진 데엔 뭐라고 적혀 있었던 거지." },
          { "t": "flag", "key": "read_report" },
          { "t": "clue", "id": "report" }
        ],
        "else": [{ "t": "text", "text": "먹칠된 사고 경위서. 원본이 어딘가에 남아 있다면…" }]
      }
    ],
    "t_photo": [
      {
        "t": "if", "cond": { "notFlag": "read_photo" },
        "then": [
          { "t": "text", "text": "담임 책상 옆에 액자 하나가 엎어져 있다." },
          { "t": "text", "text": "세워 보니 중학교 교복을 입은 두 아이가 피아노 앞에서 웃고 있다." },
          { "t": "text", "who": "재민", "text": "……나랑, 도윤이?" },
          { "t": "text", "text": "액자 뒷면에 볼펜 글씨 ── 「7월 5일. 도윤이가 첫 상담 때 두고 간 사진. \"우리 원래 친구였어요.\"」" },
          { "t": "flag", "key": "read_photo" },
          { "t": "clue", "id": "photo_friends" }
        ],
        "else": [{ "t": "text", "text": "피아노 앞의 두 아이. 뒷면에 「7월 5일. 도윤이가 첫 상담 때 두고 간 사진.」" }]
      }
    ],
    "t_desk": [
      {
        "t": "if", "cond": { "flag": "p7" },
        "then": [{ "t": "text", "text": "담임의 책상. 서랍은 이제 비어 있다." }],
        "else": [
          {
            "t": "if", "cond": { "flag": "drawer_open" },
            "then": [{ "t": "call", "name": "p7" }],
            "else": [
              { "t": "text", "text": "담임의 책상. 맨 아래 서랍에만 번호 자물쇠가 달려 있다." },
              { "t": "text", "text": "자물쇠 옆에 누렇게 바랜 쪽지 ── 「그 아이가 처음 찾아온 날.」" },
              {
                "t": "puzzle", "id": "drawer",
