  "scripts": {
    "near13": [
      { "t": "text", "text": "복도 양쪽으로 교실들이 늘어서 있다. 그중 한 교실 앞에서 발걸음이 멈춘다." },
      { "t": "text", "text": "교실 문은 반쯤 열려 있다." },
      { "t": "text", "who": "재민", "text": "여긴…" },
      { "t": "text", "text": "이상하게도, 다른 교실보다 익숙한 느낌이 든다." }
    ],
    "enter13": [
      { "t": "text", "text": "오래된 책상과 의자. 칠판에는 지워진 글씨의 흔적이 남아 있다." },
      { "t": "text", "text": "한쪽 벽에는 학급 게시판이, 교탁 위에는 무언가가 놓여 있다." }
    ],
    "lectern": [
      {
        "t": "if", "cond": { "notFlag": "read_attendance" },
        "then": [
          { "t": "text", "text": "교탁 위에 낡은 출석부가 놓여 있다." },
          { "t": "text", "text": "펼쳐 보니 한 학생의 이름만 빨간 줄로 지워져 있다." },
          { "t": "text", "text": "12번 ── (빨간 줄로 지워져 읽을 수 없다)\n13번 ── 윤재민" },
          { "t": "text", "who": "재민", "text": "내 이름이… 왜 여기 있어?" },
          { "t": "text", "text": "마지막 장을 넘긴다. 7월 14일 이후로는 출석 기록이 없다." },
          { "t": "text", "text": "그날, 12번 칸에만 아무 표시도 없다." },
          { "t": "flag", "key": "read_attendance" },
          { "t": "clue", "id": "attendance" },
          { "t": "clue", "id": "date714" }
        ],
        "else": [{ "t": "text", "text": "출석부. 12번은 빨간 줄로 지워져 있고, 13번이 내 이름이다. 마지막 출석일은 7월 14일." }]
      }
    ],
    "notice": [
      {
        "t": "if", "cond": { "notFlag": "read_seatchart" },
        "then": [
          { "t": "text", "text": "빛바랜 학급 사진 몇 장이 붙어 있다. 너무 오래되어 얼굴을 알아보기 어렵다." },
          { "t": "text", "who": "재민", "text": "……왜 이렇게 익숙하지?" },
          { "t": "text", "who": "재민", "text": "여기… 내가 있었던 곳인가?" },
          { "t": "text", "text": "기억을 떠올리려 하지만, 아무것도 생각나지 않는다." },
          { "t": "text", "text": "사진 옆에 찢어진 자리 배치도가 붙어 있다. 이름은 대부분 바래 있다." },
          { "t": "text", "text": "구석에 연필 메모 ── 「번호순. 창가 분단 맨 앞자리부터 뒤로.」" },
          { "t": "flag", "key": "read_seatchart" },
          { "t": "clue", "id": "photo" },
          { "t": "clue", "id": "seatchart" }
        ]
      },
      {
        "t": "if", "cond": { "flag": "p1" },
        "then": [{ "t": "text", "text": "자리 배치도. 창가에서 세 번째 분단, 맨 뒷자리가 12번이었다." }],
        "else": [
          {
            "t": "if", "cond": { "notFlag": "read_attendance" },
            "then": [{ "t": "text", "who": "재민", "text": "누가 몇 번이었는지 알 수 있는 게 있으면 좋을 텐데…" }],
            "else": [
              {
                "t": "choice", "prompt": "배치도에서 지워진 12번의 자리를 찾아볼까?",
                "options": [
                  {
                    "label": "찾아본다",
                    "then": [
                      {
                        "t": "puzzle", "id": "seat1",
                        "success": [
                          { "t": "flag", "key": "p1" },
                          { "t": "text", "text": "창가에서 세 번째 분단, 맨 뒷자리." },
                          { "t": "text", "who": "재민", "text": "……저 자리다." }
                        ]
                      }
                    ]
                  },
                  { "label": "그만둔다", "then": [] }
                ]
              }
            ]
          }
        ]
      }
    ],
    "board11": [{ "t": "text", "text": "칠판 구석에 「졸업 축하해!」 …폐교 전 마지막 졸업식이었을까." }],
    "board12": [{ "t": "text", "text": "칠판은 깨끗하게 지워져 있다. 너무 깨끗하다." }],
    "board13": [
      {
        "t": "if", "cond": { "flag": "frag1" },
        "then": [
          { "t": "sfx", "name": "glitch" },
          { "t": "text", "text": "칠판에 하얀 글씨가 떠올라 있다." },
          { "t": "text", "text": "「기억해.」" }
        ],
        "else": [{ "t": "text", "text": "지워진 글씨의 흔적이 남아 있다. 알아볼 수는 없다." }]
      }
    ],
    "desk": [{ "t": "text", "text": "낡은 책상. 서랍은 비어 있다." }],
    "desk_piano": [{ "t": "text", "text": "책상 위에 볼펜으로 그린 피아노 건반이 남아 있다. 손가락으로 연습이라도 한 것처럼 닳아 있다." }],
    "desk13": [
      { "t": "text", "text": "책상 귀퉁이에 「윤재민」이라고 새겨져 있다." },
      { "t": "text", "who": "재민", "text": "……내 글씨다." }
    ],
    "desk12": [
      {
        "t": "if", "cond": { "flag": "frag1" },
        "then": [{ "t": "text", "text": "12번의 책상. 서랍은 이제 비어 있다." }],
        "else": [
          {
            "t": "if", "cond": { "notFlag": "p1" },
            "then": [{ "t": "text", "text": "낡은 책상이다. 서랍이 뻑뻑해서 열리지 않는다." }],
            "else": [
              { "t": "text", "text": "힘을 주어 서랍을 당기자, 깊숙이 끼어 있던 공책 한 권이 빠져나온다." },
              { "t": "clue", "id": "notebook" },
              { "t": "text", "text": "공책은 낙서로 가득하다. 「피아노 왕자 ㅋㅋ」 「냄새나」 「꺼져」" },
              { "t": "text", "text": "그 사이에, 작고 반듯한 글씨가 있다." },
              { "t": "text", "text": "「재민이는 중학교 때 내 유일한 친구였는데.」" },
              { "t": "memory", "lines": ["(낄낄거리는 웃음소리)", "“야, 피아노 왕자. 한 곡 쳐 봐.”", "(누군가 흐느끼는 소리)", "“재민아, 너도 웃기지?”", "“……응.”"] },
              { "t": "text", "who": "재민", "text": "……방금 뭐였지?" },
              { "t": "flag", "key": "frag1" },
              { "t": "fragment", "n": 1 },
              { "t": "deduction", "id": "d1" },
              { "t": "text", "who": "재민", "text": "7월 14일… 그날 무슨 일이 있었던 거지." },
              { "t": "text", "who": "재민", "text": "학교 기록이 남아 있을 만한 곳… 입구 쪽에 경비실이 있었다." }
            ]
          }
        ]
      }
    ],
    "door_staff": [
      {
        "t": "if", "cond": { "item": "keyOffice" },
        "then": [
