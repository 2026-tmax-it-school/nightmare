  "onEnterIf": [
    {
      "once": "ret1f", "cond": { "flag": "stage2" },
      "script": [
        { "t": "wait", "ms": 300 },
        { "t": "text", "text": "1층에 내려서자 탄내가 코를 찌른다." },
        { "t": "text", "text": "복도 바닥 곳곳이 검게 그을려 있다. 마치 그날, 불이 번졌던 것처럼." },
        { "t": "sfx", "name": "whisper" },
        { "t": "text", "text": "……어디선가, 누군가 문을 두드리는 소리가 들린 것 같다." },
        { "t": "text", "who": "재민", "text": "교무실 열쇠… 교무실은 복도 동쪽 끝, 계단실 옆이었지." },
        { "t": "save" }
      ]
    }
  ],
